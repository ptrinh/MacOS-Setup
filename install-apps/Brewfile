# Apps for a new Mac. Install with: brew bundle --file Brewfile
# Upgrade all casks later (including self-updating ones): brew upgrade --cask --greedy

tap "ptrinh/tap"
tap "ptrinh/notiful"
tap "ptrinh/relaykey"

# Desktop apps
cask "google-chrome"
cask "microsoft-edge"
cask "iterm2"
cask "ghostty"            # GPU-accelerated native terminal (config in zsh-setup)
cask "textmate"
cask "discord"
cask "slack"
cask "zoom"
cask "dropbox"
cask "ledger-wallet"       # formerly ledger-live
cask "steam"               # Intel-only launcher, needs Rosetta
cask "time-out"

# Utilities
cask "little-snitch"       # approve the system extension in System Settings after install
cask "windows-app"         # replaces Microsoft Remote Desktop
cask "grandperspective"
cask "cd-to"
cask "markdown-preview"
cask "blackhole-2ch"       # virtual audio device, may need a restart
cask "the-unarchiver"
cask "balenaetcher"
cask "switchresx"
cask "ptrinh/tap/dotbar"   # DotBar (github.com/ptrinh/DotBar)
cask "ptrinh/tap/touchenv" # touchenv: secrets and SSH keys in the Keychain behind Touch ID (github.com/ptrinh/touch-env)
cask "ptrinh/notiful/notiful"           # Notiful (github.com/ptrinh/Notiful)
cask "ptrinh/relaykey/relaykey-client"  # RelayKey client (github.com/ptrinh/relaykey-public)

# Dev tools
cask "orbstack"
cask "sequel-ace"
cask "utm"                 # virtual machines
brew "dosbox-x"            # the dosbox-x cask is disabled in Homebrew; the formula works
brew "sevenzip"            # 7zz: 7-Zip on the command line, AES-256 encrypted archives
